{
  "name": "tokenbuddy-tray",
  "productName": "TokenBuddy",
  "version": "0.4.1",
  "description": "Cross-platform tray app that shows your AI API gateway balance (Sub2API / New API family / 专用站点 / custom).",
  "license": "MIT",
  "author": {
    "name": "TokenBuddy",
    "email": "noreply@example.com"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node scripts/test_adapters.js",
    "test:pet": "electron scripts/pet-state-test.js --disable-gpu --no-sandbox",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cc.tokenbuddy.tray",
    "productName": "TokenBuddy",
    "afterAllArtifactBuild": "scripts/patch-deb-postinst.js",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
